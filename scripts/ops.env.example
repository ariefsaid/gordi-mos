# Template for the untracked operations env file. Copy to ~/.config/gordi-ops/ops.env (or any path,
# then export OPS_ENV_FILE=<path>), mode 0600, and fill in real values THERE. Placeholders only in this file:
# the real file holds infrastructure coordinates and must never be committed.
# Read by: reporting-snapshot-cron.sh, ops-check.sh, db-backup.sh, deploy-production.sh.

# --- Telegram notifier (every script alerts through it) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Production database, read by ops-check.sh and db-backup.sh ---
# The password lives in a libpq password file (mode 0600, one line host:port:db:user:password), never here.
OPS_DB_HOST=db.example.invalid
OPS_DB_PORT=5432
OPS_DB_USER=ops_reader
OPS_DB_NAME=postgres
PGPASSFILE=/home/ops/.config/gordi-ops/pgpass
PGSSLMODE=require

# --- ops-check.sh (cron every 5 minutes) ---
OPS_STATE_DIR=/home/ops/.local/state/gordi-ops
OPS_APP_URL=https://app.example.invalid/
OPS_AUTH_HEALTH_URL=https://auth.example.invalid/auth/v1/health
# Optional public API key some gateways require on the health endpoint (sent on curl's stdin).
OPS_AUTH_HEALTH_APIKEY=
# File the ERP worker touches after each tick (ESB_WORKER_HEARTBEAT_FILE for the worker, same path).
OPS_ESB_HEARTBEAT_FILE=/home/ops/.local/state/gordi-ops/esb-worker.heartbeat
OPS_ESB_HEARTBEAT_MAX_AGE_MIN=15
OPS_PENDING_MAX_AGE_MIN=30
# Optional: only count outbox rows for one ERP target (dry_run | goo | gkid); empty = all.
OPS_ESB_TARGET_ENV=
# Optional: schema.table of the client-error log; empty or absent table = check skipped.
OPS_CLIENT_ERROR_TABLE=
OPS_CLIENT_ERROR_TIME_COLUMN=created_at
OPS_CLIENT_ERROR_THRESHOLD=20

# --- db-backup.sh (nightly cron) ---
OPS_BACKUP_DIR=/home/ops/backups/mos
OPS_BACKUP_KEEP_DAYS=14

# --- reporting-snapshot-cron.sh ---
SNAPSHOT_ROOT=/home/ops/snapshot-checkout
SUPABASE_PROJECT_REF=projectref
SUPABASE_POOLER_HOST=pooler.example.invalid
REPORTING_WRITER_ROLE=reporting_writer
REPORTING_ORG_ID=00000000-0000-0000-0000-000000000000
REPORTING_WRITER_CRED_FILE=/home/ops/.config/gordi-ops/reporting-writer-cred
# No password in the URL: the warehouse accepts local trust or ~/.pgpass.
WAREHOUSE_DB_URL=postgresql://warehouse_user@127.0.0.1:5432/warehouse_db

# --- deploy-production.sh (run from a main checkout on the operator's machine) ---
# Where the production connection string lives in the secret store (names only).
PRODUCTION_OP_ITEM=
PRODUCTION_OP_VAULT=
PRODUCTION_OP_FIELD=
# Directory for the pre-push dump; use a private, encrypted location.
OPS_PREDEPLOY_DUMP_DIR=/home/operator/private/mos-predeploy
