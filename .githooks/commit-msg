#!/usr/bin/env bash
# commit-msg gate — refuse a message that counts its own evidence or narrates an incident beside a
# date. Briefs advise; hooks enforce. Rationale + self-test: scripts/claim-check.sh
#
# Missing script = warn, matching .githooks/pre-commit. The two hooks used to disagree — this one
# hard-failed 127 in the sparse trees the other was softened for, so the softening never worked.
# --no-verify still skips both, which is why the CI lane re-runs the same checks over every commit
# message on the PR.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ ! -f scripts/claim-check.sh ]; then
  printf '\033[33m⚠ commit-msg: scripts/claim-check.sh missing — claim check SKIPPED\033[0m\n'
  exit 0
fi
exec bash scripts/claim-check.sh --message "$1"
