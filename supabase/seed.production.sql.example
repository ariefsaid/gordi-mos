-- supabase/seed.production.sql.example
-- COPY this template to `docs/local-seeds/02-real-roster.sql` at deploy time — NOT to a filename
-- inside this directory. `supabase/` is tracked, so a filename here is protected only by whatever
-- pattern anticipated it. `docs/` is gitignored as a whole directory and is a nested repo with no
-- remote, so `git add` cannot stage the filled-in file's contents at all.
-- Real Gordi people + real auth links. NEVER commit the filled-in file (public repo, OD-P1-6).
-- Applied manually against the deployed stack, not by `db reset`. Real names/emails go there ONLY.
--
-- SECURITY: do NOT copy the dev-auth pattern from seed.dev-auth.sql here. That file
-- provisions accounts with the public, repo-visible password `Passw0rd!dev` — fine for
-- local `.test` personas, catastrophic for real accounts. Provision real users via
-- Supabase invite / per-user passwords, and keep open signup disabled (L5 hardening).
--
-- insert into shared.people (org_id, user_id, full_name, email) values
--   ('10000000-0000-0000-0000-000000000001', '<auth.users uuid>', '<Real Name>', '<real@gordi.id>')
-- on conflict do nothing;
--
-- insert into shared.person_roles (org_id, person_id, role_id) values
--   ('10000000-0000-0000-0000-000000000001', '<person uuid>', '<role uuid>');
