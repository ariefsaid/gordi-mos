# Copy to supabase/op.staging.env (gitignored) and fill in the real names; never commit the copy.
# scripts/deploy-staging.sh passes these to op-get.sh for the staging connection and function token.
STAGING_OP_ITEM=<secret-store item name>
STAGING_OP_VAULT=<vault name>
STAGING_OP_FIELD=<field name>
STAGING_FUNCTIONS_OP_ITEM=<secret-store item name>
STAGING_FUNCTIONS_OP_VAULT=<vault name>
STAGING_FUNCTIONS_OP_FIELD=<field name>
STAGING_FN_SECRET_<NAME>=<item>|<vault>|<field>
# Server ops step (needed only when server ops scripts change): ssh host alias, the server's clone of
# this repository, its job runner, and the lock file its scheduled reporting snapshot uses.
STAGING_OPS_SSH_HOST=<ssh host alias>
STAGING_OPS_REPO_DIR=<~/path/to/clone>
STAGING_OPS_RUNNER=<~/path/to/run.sh>
STAGING_OPS_LOCK=</path/to/snapshot.lock>
