{
  "rules": {
    "color-no-hex": true,
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "oklch", "oklcha"]
  },
  "overrides": [
    {
      "files": ["src/styles/tokens/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "function-disallowed-list": null
      }
    }
  ],
  "ignoreFiles": ["dist/**", "coverage/**", "node_modules/**"]
}
