{
  "name": "mos-app",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "bash ../scripts/setup-hooks.sh || true",
    "build": "tsc -b && vite build && node scripts/check-chunk-cycles.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0 && npm run lint:css && npm run lint:clones",
    "lint:ci": "eslint . --max-warnings=0 && npm run lint:css && npm run lint:clones",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:clones": "jscpd src --config .jscpd.json",
    "quality": "bash ../scripts/quality-checks.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "bash ../scripts/with-db-lock.sh playwright test"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.55.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "cmdk": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "6.42.1",
    "puppeteer": "25.15.0",
    "stylelint": "^17.13.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
