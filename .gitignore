# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Dependencies / build
node_modules
dist
dist-ssr
*.local

# macOS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# Archives / backups
*.zip

# Test / coverage / e2e artifacts
coverage
playwright-report
test-results

# Vendored third-party Claude Code skills — re-create with scripts/vendor-skills.sh
.claude/skills/
# Codex-harness vendored skill mirror (same convention as .claude/skills/ — regenerated, not committed)
.agents/skills/

# agent worktrees (transient)
.claude/worktrees/

# Transient design-review artifacts (screenshots, Playwright-MCP dumps, audit scratch — regenerated per review)
.playwright-mcp/
/review/
/mos-*.png

# Secrets — NEVER commit (public repo). Repo-wide guard (app env lives in pmo-portal/.gitignore).
.env
.env.*
!.env.example
# Catch env files that don't START with ".env" (e.g. foo.resend.env) — the patterns above miss those.
*.env
!supabase/op.resend.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.keystore
**/serviceAccount*.json
secrets.*

# Supabase deploy-time real-people seed — NEVER commit (public repo, OD-P1-6).
# The .example template IS committed; the filled-in real file is not.
supabase/seed.production.sql

# Claude Code local (per-machine) settings — may contain personal tool allowlists
.claude/settings.local.json

# AGPL firewall — upstream Twenty CRM reference, never commit
/Twenty Design System/

# Agent run artifacts — full model transcripts. They contain whatever the agent read that run,
# so a future one could carry an env dump. 44 of these were committed to v3/v4-redesign before
# this guard existed. Regenerated per run; never commit.
.pi-subagents/
.impeccable/
.playwright-cli/
scripts/__pycache__/
# stray agent-browser output file (`--full-page` taken as a filename, not a flag)
/--full-page
