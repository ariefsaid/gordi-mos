# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Dependencies / build
node_modules
dist
dist-ssr
*.local

# macOS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# Archives / backups
*.zip

# Test / coverage / e2e artifacts
coverage
playwright-report
test-results

# Claude Code workspace — tracked in its OWN nested repo (.claude/.git), NOT by this repo.
# That repo versions agents/ + skill-overrides/ + settings.json + launch.json; vendored skills/,
# skill-original/, worktrees/, plugins/ stay regenerable/local. See .claude/.gitignore.
.claude/
# Codex-harness vendored skill mirror (same convention — regenerated, not committed)
.agents/

# Applied-path check evidence (#393): fingerprints, diffs and SUMMARY.md, regenerated per run.
# CI keeps them as a build artifact; locally they are scratch.
/artifacts/

# Transient design-review artifacts (screenshots, Playwright-MCP dumps, audit scratch — regenerated per review)
.playwright-mcp/
/review/
/mos-*.png

# sssf factory runtime (upstream install.py's entries, committed here since adws/ is tracked;
# see adws/PORT-MANIFEST.md)
adws/adw_data/sessions/
adws/adw_data/sssf.db*
__pycache__/
*.pyc

# Secrets — NEVER commit (public repo). Repo-wide guard (app env lives in pmo-portal/.gitignore).
.env
.env.*
!.env.example
# upstream sssf's key-name sample (no values) — stamped at root by vendor-skills.sh, tracked
!.env.sample
# Catch env files that don't START with ".env" (e.g. foo.resend.env) — the patterns above miss those.
*.env
!supabase/op.resend.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.keystore
**/serviceAccount*.json
secrets.*

# Residual guard only. The .example template is committed HERE; the filled-in real file belongs in
# `docs/local-seeds/` (see supabase/README.md), not at this path — this line exists to catch a
# deployer who follows an older runbook.
supabase/seed.production.sql
# Local-only database shaping — real roster, fixture teardown, dev logins. NEVER committed: this
# repo is public and these name real people. Belt-and-braces only: the files themselves live under
# `docs/`, which is a nested repo with no remote, so `git add` cannot stage anything inside it.
# Prefer that boundary over any pattern here.
supabase/seed.local-*.sql

# (.claude/settings.local.json and all other .claude/* are covered by the .claude/ rule above)

# AGPL firewall — upstream Twenty CRM reference, never commit
/Twenty Design System/

# Agent run artifacts — full model transcripts. They contain whatever the agent read that run,
# so a future one could carry an env dump. 44 of these were committed to v3/v4-redesign before
# this guard existed. Regenerated per run; never commit.
.pi-subagents/
# Impeccable design-tool workspace — critique notes, live session, hook cache: local only.
# The ONE exception is the design-system sidecar (.impeccable/design.json): a committed
# source-of-truth instrument the impeccable skill's detector reads as its canonical sidecar
# (location hard-coded in impeccable/scripts/detector/design-system.mjs). Its values mirror
# DESIGN.md, so it is public-safe and tracked, like DESIGN.md. Ignore the dir's contents, not
# the dir, so the negation below can re-include that one file.
.impeccable/*
!.impeccable/design.json
.playwright-cli/
# design-shots render output (scratch; the design-shots workflow publishes a workflow artifact only)
shots-out/
scripts/__pycache__/
# stray agent-browser output file (`--full-page` taken as a filename, not a flag)
/--full-page

# Docs — tracked in their OWN nested repo (docs/.git), NOT by this repo.
# THIS REPO IS PUBLIC (free GitHub Actions). Code syncs to GitHub; docs stay local.
# ADRs, decisions, runbooks, infra coordinates, and the archived history all live there.
# See the banner in CLAUDE.md before adding anything to the public tree.
docs/
adws/adw_data/archive/
